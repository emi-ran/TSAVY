{
  "manifest_version": 3,
  "name": "TSAVY — YouTube Altyazıları",
  "version": "0.1.0",
  "description": "YouTube transkriptlerini görüntüler ve seçtiğiniz yapay zekâ ile özetler.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "tabs", "scripting", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "TSAVY panelini aç", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "side_panel": { "default_path": "panel.html" }
}
